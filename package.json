  "scripts": {
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --no-coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:js": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects js --no-coverage",
    "test:rust": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects rust --no-coverage",
    "test:erlang": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects erlang --no-coverage"
