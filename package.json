{
  "name": "brevity-lang",
  "version": "1.0.0",
  "description": "A simple library for brevity",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:js && npm run test:erlang && npm run test:rust",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:js": "node --experimental-vm-modules node_modules/.bin/jest --selectProjects js",
    "test:rust": "BREVITY_TARGET=rust node --experimental-vm-modules node_modules/.bin/jest --runInBand --selectProjects rust",
    "test:erlang": "BREVITY_TARGET=erlang node --experimental-vm-modules node_modules/.bin/jest --selectProjects erlang"
  },
  "keywords": [
    "brevity",
    "library",
    "utility"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "exports": {
    ".": "./index.js"
  }
}
