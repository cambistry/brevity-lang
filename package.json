{
  "name": "brevity-lang",
  "version": "0.0.1",
  "description": "A simple library for brevity",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --no-coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ __tests__/ index.js",
    "test:js": "npm run lint && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects js --no-coverage",
    "test:rust": "eslint src/codegen/rust/ && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects rust --no-coverage",
    "test:erlang": "eslint src/codegen/erlang/ && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects erlang --no-coverage",
    "test:browser": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects browser --no-coverage"
  },
  "keywords": [
    "brevity",
    "library",
    "utility"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-plugin-jest": "^29.15.1",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./index.js"
  }
}
