{
  "name": "brevity-lang",
  "version": "0.0.1",
  "description": "A CAM-oriented actor language that compiles to JavaScript, Rust, and Erlang.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --max-old-space-size=4096 --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects js rust erlang --no-coverage --randomize && npm run test:browser",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ __tests__/ index.js",
    "test:js": "npm run lint && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects js --no-coverage --randomize",
    "test:rust": "eslint src/codegen/rust/ && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects rust --no-coverage --randomize",
    "test:erlang": "eslint src/codegen/erlang/ && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects erlang --no-coverage --randomize",
    "test:browser": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest --selectProjects browser --no-coverage --forceExit --randomize --maxWorkers=2"
  },
  "keywords": [
    "brevity",
    "cam",
    "actors",
    "language",
    "compiler"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-plugin-jest": "^29.15.1",
    "globals": "^17.4.0",
    "jest": "^29.7.0",
    "playwright": "^1.59.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./index.js"
  }
}
